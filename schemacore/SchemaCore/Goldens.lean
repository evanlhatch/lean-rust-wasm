e::Deserializer<'de>>(deserializer: D)\n        -> Result<Self, D::Error> {\n        struct ExampleV2Visitor;\n        impl<'de> serde::de::Visitor<'de> for ExampleV2Visitor {\n            type Value = ExampleV2;\n            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n                f.write_str(\"struct ExampleV2\")\n            }\n            fn visit_map<A: serde::de::MapAccess<'de>>(\n                self, mut map: A,\n            ) -> Result<ExampleV2, A::Error> {\n                let mut ready: Option<bool> = None;\n                let mut count: Option<u64> = None;\n                let mut label: Option<String> = None;\n                let mut delta: Option<i64> = None;\n                while let Some(k) = map.next_key::<String>()? {\n                    match k.as_str() {\n                        \"ready\" => {\n                            if ready.is_some() {\n                                return Err(serde::de::Error::duplicate_field(\"ready\"));\n                            }\n                            ready = Some(map.next_value()?);\n                        }\n                        \"count\" => {\n                            if count.is_some() {\n                                return Err(serde::de::Error::duplicate_field(\"count\"));\n                            }\n                            count = Some(map.next_value()?);\n                        }\n                        \"label\" => {\n                            if label.is_some() {\n                                return Err(serde::de::Error::duplicate_field(\"label\"));\n                            }\n                            label = Some(map.next_value()?);\n                        }\n                        \"delta\" => {\n                            if delta.is_some() {\n                                return Err(serde::de::Error::duplicate_field(\"delta\"));\n                            }\n                            delta = Some(map.next_value()?);\n  
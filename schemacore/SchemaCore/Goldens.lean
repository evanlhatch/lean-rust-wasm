    throwError "Goldens: the lib.rs rope drifted from the committed \
      golden — run `just gen` and commit (never hand-edit)"

set_option maxRecDepth 100000 in
/-- THE DIFFERENTIAL TIE: the differential's body is the committed
    vector file's bytes, kernel-reduced (all-structural fold +
    `encVal`'s dependent fold). -/
theorem diff_artifact :
    Emit.Rust.renderDifferential = goldenDiff := rfl

set_option maxRecDepth 100000 in
/-- THE TS TIE (the SECOND CodeTarget row's channel): the TS emitter's
    run over the pinned registry IS the committed golden —
    kernel-reduced (the TS rope is all-structural folds; the body is
    differential-sized, the same chunk-crack budget the differential
    rides). -/
theorem ts_artifact :
    Emit.Ts.tsEmitter.run sliceReg
      = [{ path := "gen/schema-slice.ts", contents := goldenTs }] := rfl

/-! ## The teeth (the live link) -/

/-- BUILD-TIME TEETH: the pinned registry IS the live registration
    (the replayed `@[schema]` state of the imported `SchemaCore.Slice`).
    A universe change without `just gen` FAILS THE BUILD here — the
    theorem channel stays glued to the live registry. -/
unsafe def goldensTeeth : Lean.Elab.Command.CommandElabM Unit := do
  let env ← Lean.getEnv
  match ← Lean.Elab.Command.liftCoreM (getSchemas env) with
  | .error e => throwError s!"Goldens: the live `@[schema]` replay refused: {e}"
  | .ok items =>
    unless items == sliceItems do
      throwError "Goldens: the live `@[schema]` registration drifted from \
        the pinned sliceItems — run `just gen` and commit (the golden \
        module is generated; never hand-edit)"

#eval goldensTeeth

end SchemaCore.Goldens

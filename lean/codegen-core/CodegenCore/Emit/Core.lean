/-
# CodegenCore.Emit.Core — the emitter discipline

Lifted from flatland's `Codegen.Emit.Core` (lean-v3 §7.2, D6, D7). The
rules:

- Target AST → skeleton → tokens → text. Text via `Std.Format`, never
  string interpolation for structure.
- Name-mangling in ONE module per target — the most common codegen bug
  class, centralized here.
- Deterministic output: sorted/registry-order emission, `StateM Nat` fresh
  names. Byte-tie CI regenerates and diffs (lean4-mlir's discipline).
- Every generated file carries the header citing its spec source — so an
  agent knows: regenerate, don't edit.
-/

namespace CodegenCore.Emit

/-- The generated-file header. Every artifact, always. `tool` names the
    emitting package (e.g. `"schema-lang"`), `specSource` the registry or
    spec module the artifacts derive from. Comment prefix per target:
    Lean/SQL `--`, Rust/WIT `//`, YAML/Python `#`. -/
inductive CommentStyle where
  | lean | doubleSlash | hash

def CommentStyle.prefix : CommentStyle → String
  | .lean => "-- "
  | .doubleSlash => "// "
  | .hash => "# "

def CommentStyle.line (s : CommentStyle) (text : String) : String :=
  s.prefix ++ text

def header (style : CommentStyle) (tool specSource : String) : String :=
  CommentStyle.line style (s!"GENERATED by {tool} — DO NOT EDIT") ++ "\n"
    ++ CommentStyle.line style (s!"spec source: {specSource}") ++ "\n"
    ++ CommentStyle.line style "regenerate via `just gen`; drift fails CI (byte-tie)" ++ "\n"

/-! ## The emitter-plugin model (buf/protoc architecture)

ONE parsed spec, MANY emitter plugins. `Emitter Spec` is parameterized
over the spec descriptor type — schema-lang instantiates `Spec :=
List Item`; any other spec language reuses the model. Each plugin
declares its output paths (the one-writer audit surface) and is a pure
function from spec to files; the driver prepends headers and writes. -/

/-- One generated artifact: repo-root-relative path + content (header
    prepended by the driver, not by the emitter). -/
structure GeneratedFile where
  path : String
  contents : String

/-- An emitter plugin: one language target. -/
structure Emitter (Spec : Type) where
  /-- Plugin name (buf: the plugin suffix). -/
  name : String
  /-- Comment prefix for the generated header. -/
  style : CommentStyle
  /-- The spec module the artifacts derive from (audit provenance). -/
  specSource : String
  /-- Declared output paths, repo-root-relative. MUST be unique across
      the registry (the one-writer discipline, checked in Tests). -/
  outputs : List String
  /-- Fold the spec into files. Pure and deterministic (tested). -/
  run : Spec → List GeneratedFile

/-! ## Name mangling (one place, every target)

Identifiers arrive as registry names (dot/space/dash separated words).
Each target gets its convention; collision-safe by construction since
registry names are unique. -/

/-- Split a registry name into lowercase word parts: separators AND
    lower→Upper humps both split (`maxHealth` → [max, health]). -/
def words (s : String) : List String := Id.run do
  let mut cur : String := ""
  let mut out : List String := []
  let mut prevLower := false
  for c in s.toList do
    if c == '.' || c == '-' || c == '_' || c == ' ' then
      if cur != "" then out := out ++ [cur]
      cur := ""
      prevLower := false
    else if c.isUpper && prevLower then
      out := out ++ [cur]
      cur := c.toLower.toString
      prevLower := false
    else
      cur := cur ++ c.toLower.toString
      prevLower := !(c.isUpper)
  if cur != "" then out := out ++ [cur]
  return out

def capitalize (s : String) : String :=
  match s.toList with
  | [] => ""
  | c :: cs => String.ofList (c.toUpper :: cs)

/-- `foo_bar baz` → `fooBarBaz` (Rust fn, Lean field). Also WIT kebab via
    the `kebab` sibling in target modules. -/
def camel (s : String) : String :=
  match words s with
  | [] => ""
  | w :: ws => w ++ String.join (ws.map capitalize)

/-- `foo_bar` → `FooBar` (Rust/Lean type). -/
def pascal (s : String) : String := String.join ((words s).map capitalize)

/-- `FooBar baz` → `foo_bar_baz` (Rust module, SQL table). -/
def snake (s : String) : String := String.intercalate "_" (words s)

/-- `foo_bar` → `foo-bar` (WIT identifiers are kebab-case). -/
def kebab (s : String) : String := String.intercalate "-" (words s)

/-- Escape a JSON string (paths + names only — quotes and backslashes
    are the whole story). Shared by every manifest emitter (schema-lang's
    Registry + WitFixture both consume it; it lives here so neither can
    import-cycle the other). -/
def jsonStr (s : String) : String :=
  "\"" ++ (s.replace "\\" "\\\\").replace "\"" "\\\"" ++ "\""

/-- Rust keywords get a raw-identifier escape; the only mangling surprise
    that is allowed to exist. -/
def rustIdent (s : String) : String :=
  let kw := ["as", "break", "const", "continue", "crate", "else", "enum",
    "extern", "false", "fn", "for", "if", "impl", "in", "let", "loop",
    "match", "mod", "move", "mut", "pub", "ref", "return", "self", "Self",
    "static", "super", "trait", "true", "type", "unsafe", "use", "where",
    "while", "async", "await", "dyn", "box"]
  let c := camel s
  if kw.contains c then s!"r#{c}" else c

end CodegenCore.Emit

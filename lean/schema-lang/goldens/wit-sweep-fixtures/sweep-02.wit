package demo:sweep-02;

interface sweep-02-types {
record order {
  f0: bool,
}
record summary {
  f0: list<tuple<s8, option<list<s16>>>>,
  f1: u64,
}
variant shape {
  c0(list<tuple<string, option<f32>>>),
  c1,
  c2,
}
}

interface sweep-02-exports {
    watch: async func(p0: f32, p1: f32) -> u32;
}

world sweep-02 {
  export sweep-02-exports;
}

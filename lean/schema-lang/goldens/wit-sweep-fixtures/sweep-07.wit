package demo:sweep-07;

interface sweep-07-types {
record order {
  f0: option<s16>,
  f1: result<option<list<u64>>, list<list<tuple<string, option<u64>>>>>,
  f2: list<list<tuple<s32, option<f64>>>>,
  f3: list<u8>,
}
record summary {
  f0: list<list<tuple<u32, option<s64>>>>,
  f1: f64,
  f2: list<list<tuple<u8, option<u64>>>>,
}
variant shape {
  c0,
  c1(list<tuple<s8, option<string>>>),
  c2,
  c3(list<tuple<u8, option<list<tuple<u32, option<s16>>>>>>),
}
}

interface sweep-07-exports {
    watch: func(p0: s16, p1: result<list<u8>, option<s32>>) -> s8;
}

world sweep-07 {
  export sweep-07-exports;
}

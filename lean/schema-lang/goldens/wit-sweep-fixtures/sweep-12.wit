package demo:sweep-12;

interface sweep-12-types {
record order {
  f0: u64,
  f1: result<list<list<u16>>, list<u8>>,
  f2: list<string>,
}
record summary {
  f0: s32,
  f1: result<list<bool>, s32>,
  f2: option<s32>,
}
variant shape {
  c0(list<option<f64>>),
  c1(list<list<tuple<s32, option<s32>>>>),
  c2,
  c3,
}
}

interface sweep-12-exports {
    watch: func(p0: result<bool, s32>) -> string;
}

world sweep-12 {
  export sweep-12-exports;
}
